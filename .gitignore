# Scratch copies. This repository does not run the full-auto-dev process on
# itself, so nothing here is the archive that Document Rules 3.10 requires;
# a user project tracks its old/ instead (see gitignore-user.template).
old/

# Dependencies
node_modules/

# Test coverage (generated by Vitest)
coverage/

# Secrets and keys
.env
.env.*
*.pem
*.key

# Claude Code local settings
.claude/settings.local.json

# Rewritten by tools/otel-sink.mjs as telemetry arrives, and on the CLI also by
# tools/session-meter.mjs. progress-monitor distills it into cost-log.json,
# which is the record worth keeping; this file is the live reading.
project-management/progress/session-state.json

# Framework development private files (not distributed)
prompt/
maintenance/temporary/

# setup.js deploy outputs.
# The originals live under framework-src/{lang}/ and ARE tracked.
# The leading "/" anchors each rule to the repo root so framework-src/ is untouched.
/.claude/agents/
/.claude/commands/
/process-rules/
/CLAUDE.md
/user-order.md
