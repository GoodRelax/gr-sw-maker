# .gitignore for a gr-sw-maker project.
#
# The suffix-less files under .claude/ and process-rules/ are generated by
# setup.js from framework-src/, but in this project they ARE the working files
# and should be committed. The framework repo itself ignores those same paths,
# which is why it cannot share this file and ships it separately instead.

# Dependencies
node_modules/

# Test coverage
coverage/

# Secrets and keys
.env
.env.*
*.pem
*.key

# Claude Code local settings
.claude/settings.local.json

# Rewritten by tools/otel-sink.mjs as telemetry arrives, and on the CLI also by
# tools/session-meter.mjs. progress-monitor distills it into cost-log.json,
# which is the record worth keeping; this file is the live reading.
project-management/progress/session-state.json

# old/ is deliberately NOT ignored. Document Rules 3.10 makes it the archive
# destination: an approved document is moved to old/{name}-v{version}.md before
# the new version takes its place. project-records/ is the audit trail, and
# ignoring old/ would throw away the previous version of every approved
# document the process was required to keep.
